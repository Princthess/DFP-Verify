# Copy this file to `.env` and fill in your values.
# run_pipeline.py and run_integrated.py read it at startup; a shell variable (set DV_...) overrides it.

# Your email, added to the User-Agent of DataCite / registry API requests (politeness, "polite pool").
DV_CONTACT_EMAIL=you@example.org

# --- Version A (run_pipeline.py): verify an existing DFP run (no DFP install needed) ---
# DV_TEXT_DIR=path/to/paper_txt      # folder of per-paper .txt
# DV_DFP_CSV=path/to/dfp_output.csv  # DFP's output CSV

# --- Version B (run_integrated.py): paths/backend can live here instead of the shell (all optional) ---
# DV_PDF_DIR=path/to/pdfs
# DV_DFP_DIR=path/to/datasets-from-pdf
# DV_BACKEND=litellm
# DV_OUT_DIR=output
# DV_NO_REFS=0

# NOTE: the LiteLLM endpoint (LITELLM_BASE_URL / VLM_MODEL / LITELLM_API_KEY) is DFP's own .env,
# which lives in DV_DFP_DIR and is read by DFP — not by this tool.

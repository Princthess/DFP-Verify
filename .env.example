# Copy this file to .env and fill in the paths. Lines starting with # are ignored.
# A value set in the shell overrides the one here.

# --- needed ---
DV_CONTACT_EMAIL=you@example.org
DV_DFP_CSV=path/to/dfp_output.csv
DV_TEXT_DIR=path/to/paper_txt_folder

# --- optional ---
# where results go (default: output/)
# DV_OUT_DIR=output
# off = skip the research-field lookup (Swepub / OpenAlex); verdicts are the same
DV_FIELDS=on
# your PDFs: only used to tell why a dataset id was broken
# DV_PDF_DIR=path/to/pdfs
# your organisation, for Zenodo communities in the report and the RoAgg comparison
# DV_ORG_NAME=Chalmers
# DV_ORG_ROR=https://ror.org/040wg7k59
# a name for this run, shown in the report (default: the text folder's name)
# DV_CORPUS=

# --- only for run_integrated.py (runs DFP first) ---
# DV_DFP_DIR=path/to/datasets-from-pdf
# DV_BACKEND=litellm
# DV_MODEL=
# DV_NO_REFS=
